# Required for AI-generated posts.
OPENAI_API_KEY=

# Optional. Defaults to gpt-4.1-mini if omitted.
OPENAI_MODEL=gpt-4.1-mini

# Required only when DRY_RUN=false.
# Use an OAuth 2.0 user access token with tweet.write permission for the bot account.
X_USER_ACCESS_TOKEN=
X_REFRESH_TOKEN=
X_CLIENT_ID=
X_CLIENT_SECRET=

# Recommended for GitHub Actions because these user-context tokens do not need
# the OAuth 2.0 refresh-token dance.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Keep true while testing. Set false only after the bot account/API access is ready.
DRY_RUN=true

# Bot identity used in logs/prompts.
BOT_BRAND=ceobeingceo

# Maximum automatic posts created per run.
POSTS_PER_RUN=3

# Minimum minutes between scheduled posts.
MIN_POST_INTERVAL_MINUTES=180

# Keep this low to make the bot mostly plain text and avoid URL-heavy X API costs.
# 0 = only quotes/lessons, 1 = allow one sourced summary per generation run.
SOURCE_SUMMARIES_PER_RUN=1
